<!doctype html><html lang="es"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>AML Analytical Workbench · v0.11.0 · DESKTOP ADVANCED</title><style>
:root{--navy:#09162d;--navy2:#112644;--blue:#2b6ff3;--cyan:#1495a3;--ink:#182132;--muted:#687486;--line:#e4e9f0;--bg:#f4f6f9;--card:#fff;--red:#c94b55;--amber:#be8429;--green:#278563;--purple:#7659d6;--orange:#e77d36;--r:12px;--shadow:0 6px 22px rgba(16,24,40,.06)}*{box-sizing:border-box}html,body{margin:0;background:var(--bg);color:var(--ink);font-family:Inter,ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif}button,input,select{font:inherit}button{cursor:pointer}.load{position:fixed;inset:0;background:var(--navy);color:#fff;z-index:99;display:flex;align-items:center;justify-content:center;flex-direction:column;gap:12px}.load b{font-size:19px}.load small{color:#aebbd0}.spinner{width:28px;height:28px;border:3px solid #52617a;border-top-color:#fff;border-radius:50%;animation:sp .8s linear infinite}@keyframes sp{to{transform:rotate(360deg)}}.header{height:66px;background:linear-gradient(105deg,var(--navy),#10264a);color:#fff;display:flex;align-items:center;padding:0 22px;gap:16px;position:sticky;top:0;z-index:30;box-shadow:0 4px 18px rgba(0,0,0,.16)}.brand{width:215px;min-width:215px}.brand b{display:block;font-size:15px}.brand small{font-size:9px;color:#aebbd0}.command{flex:1;max-width:900px;background:#fff;border-radius:9px;display:flex;align-items:center;overflow:hidden}.command span{color:#6d798c;padding-left:12px}.command input{flex:1;border:0;outline:0;padding:10px;color:#263149;font-size:11px}.command button{border:0;background:var(--blue);color:#fff;padding:10px 15px;font-weight:750;font-size:10px}.headright{margin-left:auto;display:flex;gap:7px}.sys,.export{border:1px solid rgba(255,255,255,.17);background:rgba(255,255,255,.06);color:#e0e7f2;border-radius:8px;padding:8px 9px;font-size:9px}.dot{display:inline-block;width:7px;height:7px;background:#54c78f;border-radius:50%;margin-right:5px}.filters{height:47px;background:#fff;border-bottom:1px solid var(--line);display:flex;align-items:center;gap:6px;padding:0 22px;position:sticky;top:66px;z-index:25}.filters select{border:1px solid #dfe5ed;border-radius:7px;background:#fff;padding:6px 8px;font-size:9px;color:#576477}.fl{font-size:8px;color:#8994a4;text-transform:uppercase;letter-spacing:.35px;margin-left:4px}.grow{flex:1}.live{font-size:8px;font-weight:800;color:#267257;background:#effaf5;border:1px solid #d2ecdf;border-radius:999px;padding:5px 7px}.workspace{display:grid;grid-template-columns:270px minmax(610px,1fr) 315px;min-height:calc(100vh - 155px);max-width:1900px;margin:auto}.left{background:#fbfcfd;border-right:1px solid var(--line);padding:14px 11px;overflow:auto}.center{padding:16px;min-width:0}.right{background:#fbfcfd;border-left:1px solid var(--line);padding:14px 12px;overflow:auto}.st{display:flex;gap:6px;align-items:center;margin:0 3px 9px}.st b{font-size:10px}.st small{margin-left:auto;color:#8994a4;font-size:8px}.focus{background:#fff;border:1px solid var(--line);border-radius:9px;padding:9px;margin-bottom:6px;cursor:pointer}.focus:hover,.focus.active{background:#f8faff;border-color:#bacbea}.focus .type{font-size:7px;color:#7d899a;text-transform:uppercase;font-weight:850;letter-spacing:.45px}.focus h4{font-size:10px;line-height:1.35;margin:4px 0}.focus p{font-size:8px;color:#758195;line-height:1.35;margin:0}.fm{display:flex;gap:4px;align-items:center;margin-top:6px}.mini{font-size:7px;background:#f2f5f8;border-radius:5px;padding:3px 5px;color:#667285}.prio{margin-left:auto;font-size:10px;font-weight:850}.card{background:#fff;border:1px solid var(--line);border-radius:var(--r);box-shadow:var(--shadow)}.answer{padding:16px 17px;margin-bottom:11px;border-top:3px solid var(--blue)}.answerTop{display:flex;gap:10px;align-items:flex-start}.eyebrow{font-size:7px;text-transform:uppercase;color:#7f8a9a;font-weight:850;letter-spacing:.55px}.answer h1{font-size:19px;line-height:1.25;letter-spacing:-.3px;margin:4px 0 5px}.answer p{font-size:10px;line-height:1.5;color:#626f81;margin:0;max-width:920px}.scorebox{margin-left:auto;text-align:right;min-width:95px}.scorebox b{display:block;font-size:22px}.scorebox span{font-size:7px;color:#8993a2;text-transform:uppercase}.chips{display:flex;gap:4px;flex-wrap:wrap;margin-top:9px}.chip{font-size:7px;border:1px solid #dfe5ed;border-radius:5px;background:#fafbfd;color:#5e6b7e;padding:4px 6px}.chip.blue{background:#edf3ff;border-color:#cfddff;color:#275ab8}.chip.warn{background:#fff8ed;border-color:#f0d8b8;color:#8f6027}.kpis{display:grid;grid-template-columns:repeat(4,1fr);gap:8px;margin-bottom:11px}.kpi{padding:11px 12px;min-height:78px}.kpi small{font-size:7px;color:#8590a0;text-transform:uppercase;font-weight:800;letter-spacing:.35px}.kpi b{display:block;font-size:20px;letter-spacing:-.3px;margin:5px 0 1px}.kpi span{font-size:8px;color:#758194}.red{color:var(--red)!important}.green{color:var(--green)!important}.amber{color:var(--amber)!important}.grid{display:grid;gap:10px}.two{grid-template-columns:1.22fr .78fr}.equal{grid-template-columns:1fr 1fr}.panel{padding:13px}.ph{display:flex;gap:8px;align-items:flex-start;margin-bottom:9px}.ph b{font-size:10px}.ph p{font-size:8px;color:#7e8999;margin:2px 0 0;line-height:1.35}.pill{font-size:7px;border:1px solid var(--line);border-radius:999px;padding:4px 6px;color:#697588}.tablewrap{overflow:auto;max-height:390px}table{width:100%;border-collapse:collapse;font-size:8px}th{text-align:left;font-size:6.5px;text-transform:uppercase;color:#8994a4;letter-spacing:.35px;padding:7px 6px;border-bottom:1px solid var(--line);position:sticky;top:0;background:#fff;z-index:2}td{padding:7px 6px;border-bottom:1px solid #eef1f5;vertical-align:middle}tr.click:hover{background:#f8faff;cursor:pointer}.rank{display:inline-flex;width:19px;height:19px;align-items:center;justify-content:center;background:#f2f5f8;border-radius:5px;font-size:7px;font-weight:800}.factor{display:grid;grid-template-columns:130px 1fr 42px;gap:7px;align-items:center;margin:8px 0}.factor span{font-size:8px;color:#647185}.factor b{text-align:right;font-size:8px}.track{height:6px;background:#edf1f5;border-radius:7px;overflow:hidden}.track i{display:block;height:100%;background:var(--blue);border-radius:7px}.note{font-size:8px;line-height:1.45;color:#677487;background:#f7f9fc;border:1px solid #e4e9f0;border-radius:8px;padding:8px}.warnbox{font-size:8px;line-height:1.45;color:#765e37;background:#fff9ef;border-left:3px solid var(--amber);padding:8px;margin-top:8px}.contextBlock{margin-bottom:12px}.contextBlock h3{font-size:9px;margin:0 0 6px}.contextBlock p{font-size:8px;color:#6f7b8d;line-height:1.45;margin:0}.evidence{background:#fff;border:1px solid var(--line);border-radius:8px;padding:8px;margin:5px 0}.evidence b{font-size:8px}.evidence p{font-size:7.5px;color:#788496;line-height:1.4;margin:4px 0}.evidence a{font-size:7px;color:#245ac2;text-decoration:none}.coverage{display:grid;grid-template-columns:105px 1fr 34px;gap:6px;align-items:center;margin:7px 0}.coverage span,.coverage b{font-size:7px}.health{height:5px;background:#edf1f5;border-radius:5px;overflow:hidden}.health i{display:block;height:100%}.chart{width:100%;height:205px}.gridline{stroke:#edf0f4;stroke-width:1}.lineA{fill:none;stroke:var(--blue);stroke-width:2.5}.lineB{fill:none;stroke:var(--cyan);stroke-width:2}.axistext{font-size:7px;fill:#8994a4}.legend{display:flex;gap:11px;font-size:7px;color:#758195}.legend i{display:inline-block;width:7px;height:7px;border-radius:50%;margin-right:3px}.map{width:100%;height:370px;background:#f9fbfd;border-radius:8px}.territory{stroke:#fff;stroke-width:1;cursor:pointer}.territory:hover{stroke:#263b5d;stroke-width:1.5}.net{width:100%;height:285px;background:linear-gradient(#fbfcfe,#f8fafc);border-radius:8px}.edge{stroke:#cbd4df;stroke-width:1.2}.edge.dash{stroke-dasharray:4 3}.node{stroke:#fff;stroke-width:3}.nlabel{font-size:7px;fill:#596679;text-anchor:middle}.timeline{position:relative;padding-left:16px}.timeline:before{content:"";position:absolute;left:4px;top:4px;bottom:4px;width:2px;background:#e2e7ee}.event{position:relative;margin-bottom:9px}.event:before{content:"";position:absolute;left:-16px;top:2px;width:7px;height:7px;border-radius:50%;background:var(--blue);border:2px solid #fff;box-shadow:0 0 0 1px #ccd5e0}.event small{font-size:6.5px;color:#8994a4}.event b{display:block;font-size:8px;margin:1px 0}.event p{font-size:7px;color:#758195;line-height:1.4;margin:0}.button{border:1px solid var(--line);background:#fff;border-radius:7px;padding:6px 8px;font-size:8px;color:#536074}.searchResults{max-height:420px;overflow:auto}.searchItem{padding:8px;border-bottom:1px solid var(--line);cursor:pointer}.searchItem:hover{background:#f8faff}.searchItem b{display:block;font-size:9px}.searchItem small{font-size:7px;color:#7b8797}.missing{padding:18px;text-align:center;color:#7d8998;font-size:9px;border:1px dashed #d8dee7;border-radius:8px;background:#fafbfd}.leftnote{font-size:7.5px;color:#8994a4;line-height:1.45;padding:8px 4px}.tooltip{position:fixed;z-index:80;background:#0c1a33;color:#fff;padding:6px 8px;border-radius:6px;font-size:7px;pointer-events:none;display:none;max-width:260px}.footer{font-size:6.5px;color:#98a1ae;text-align:center;margin-top:8px}
.kpi.action{cursor:pointer;position:relative;border-color:#cbd9f4;background:linear-gradient(180deg,#fff,#f8fbff)}.kpi.action:hover{box-shadow:0 8px 22px rgba(43,111,243,.12);transform:translateY(-1px)}.kpi.action:after{content:"Abrir detalle →";position:absolute;right:10px;bottom:7px;font-size:6.5px;color:#2b6ff3;font-weight:800}.breachlink{border:0;background:transparent;color:#2159c5;font-weight:850;padding:2px 3px;text-decoration:underline;text-decoration-style:dotted;text-underline-offset:2px}.breachlink:hover{color:#143f95}.gapbar{display:flex;gap:7px;align-items:center;flex-wrap:wrap;margin-bottom:9px}.gapbar input,.gapbar select{border:1px solid #dfe5ed;border-radius:7px;background:#fff;padding:6px 7px;font-size:8px;color:#536074}.gapbar input{min-width:220px;flex:1}.gapbar .grow{flex:1}.gapmeta{font-size:7.5px;color:#748195}.screeningTag{display:inline-block;font-size:6.5px;padding:3px 5px;border-radius:5px;background:#fff7e9;color:#8b5d25;border:1px solid #efd7b8;white-space:nowrap}.fusionTag{display:inline-block;font-size:6.5px;padding:3px 5px;border-radius:5px;background:#edf7f3;color:#267257;border:1px solid #cde8dc;white-space:nowrap}.pager{display:flex;align-items:center;justify-content:flex-end;gap:7px;margin-top:8px;font-size:7.5px;color:#718095}.pager button{border:1px solid var(--line);background:#fff;border-radius:6px;padding:5px 7px;font-size:7px;color:#536074}.candidateTitle{font-size:11px;font-weight:850;margin-bottom:3px}.candidateRut{font-size:8px;color:#738094;margin-bottom:8px}.activityList{display:flex;flex-direction:column;gap:5px}.activityItem{border:1px solid var(--line);border-radius:7px;padding:6px;background:#fff}.activityItem b{font-size:7.5px}.activityItem p{font-size:7px;color:#748195;margin:3px 0 0;line-height:1.35}.screeningGuard{font-size:7.5px;line-height:1.45;color:#765e37;background:#fff9ef;border-left:3px solid var(--amber);padding:8px;margin:8px 0}.gapHeader{display:flex;align-items:center;gap:7px;margin-bottom:9px}.gapHeader .count{font-size:18px;font-weight:850}.gapHeader .sub{font-size:8px;color:#7d8999}.smallbtn{border:1px solid var(--line);background:#fff;border-radius:6px;padding:5px 7px;font-size:7px;color:#536074}.smallbtn.primary{background:#2b6ff3;border-color:#2b6ff3;color:#fff}.screeningRow td{vertical-align:top}.screeningRow .name{font-weight:800;font-size:8px}.screeningRow .rut{font-size:7px;color:#8792a2}.activitiesMini{max-width:280px;color:#657286;line-height:1.35}.emptyState{padding:20px;text-align:center;color:#8390a2;font-size:8px;border:1px dashed #dbe1e9;border-radius:8px;background:#fafbfd}

.appsbar{height:42px;background:#f8fafc;border-bottom:1px solid var(--line);display:flex;align-items:center;gap:5px;padding:0 22px;position:sticky;top:113px;z-index:24;overflow-x:auto}
.appbtn{border:1px solid transparent;background:transparent;border-radius:7px;padding:6px 8px;font-size:7.5px;color:#647185;white-space:nowrap;display:flex;align-items:center;gap:5px}
.appbtn:hover{background:#fff;border-color:#dfe5ed;color:#24344e}.appbtn.on{background:#eaf1ff;border-color:#cbdcff;color:#2458ba;font-weight:850}
.appcount{font-size:6.5px;min-width:18px;text-align:center;padding:2px 4px;border-radius:999px;background:#edf1f6;color:#657286}.appbtn.on .appcount{background:#fff;color:#2458ba}
.markbar{display:flex;gap:5px;flex-wrap:wrap;margin:8px 0}.mark{font-size:6.8px;padding:4px 6px;border-radius:5px;border:1px solid #dce3ec;background:#f8fafc;color:#607086;font-weight:750}
.mark.good{background:#edf9f4;border-color:#cde7dc;color:#267257}.mark.warn{background:#fff7e9;border-color:#efd7b8;color:#875b25}.mark.info{background:#edf3ff;border-color:#cfddff;color:#285ab6}.mark.alert{background:#fff0f2;border-color:#f2cbd0;color:#a3414b}.mark.context{background:#f4f1ff;border-color:#ddd5fa;color:#6550b3}
.actionrow{display:flex;gap:6px;flex-wrap:wrap;margin-top:9px}.actionbtn{border:1px solid #dbe3ed;background:#fff;color:#536277;border-radius:7px;padding:6px 8px;font-size:7.5px;font-weight:700}.actionbtn:hover{border-color:#aebfda;background:#f8faff}.actionbtn.primary{background:#2b6ff3;color:#fff;border-color:#2b6ff3}
.appgrid{display:grid;grid-template-columns:repeat(3,1fr);gap:9px}.appcard{border:1px solid var(--line);background:#fff;border-radius:10px;padding:11px;cursor:pointer;min-height:98px}.appcard:hover{border-color:#b9cbea;box-shadow:0 6px 18px rgba(43,111,243,.08)}.appcard .icon{font-size:17px}.appcard b{display:block;font-size:10px;margin:7px 0 3px}.appcard p{font-size:7.5px;color:#778497;line-height:1.4;margin:0}.appcard .stat{font-size:15px;font-weight:850;color:#2b6ff3;float:right}
.controlbar{display:flex;gap:6px;align-items:center;flex-wrap:wrap;margin-bottom:9px}.controlbar input,.controlbar select,.compareSelect{border:1px solid #dfe5ed;border-radius:7px;background:#fff;padding:6px 7px;font-size:8px;color:#536074}.controlbar input{min-width:190px;flex:1}
.tabs{display:flex;gap:3px;border-bottom:1px solid var(--line);margin-bottom:9px}.tabs button{border:0;background:transparent;padding:7px 9px;font-size:7.5px;color:#6d798b;border-bottom:2px solid transparent}.tabs button.on{color:#2458ba;border-bottom-color:#2b6ff3;font-weight:850}
.sanctionTag{font-size:6.5px;padding:3px 5px;border-radius:5px;background:#fff1f2;color:#a3414b;border:1px solid #f1cdd1}.resolvedTag{font-size:6.5px;padding:3px 5px;border-radius:5px;background:#edf9f4;color:#267257;border:1px solid #cce7da}.unresolvedTag{font-size:6.5px;padding:3px 5px;border-radius:5px;background:#fff7e9;color:#875b25;border:1px solid #efd7b8}
.caseBadge{font-size:6.5px;padding:3px 5px;background:#f2efff;color:#6651b6;border:1px solid #ddd5fa;border-radius:5px}.caseCard{border:1px solid var(--line);border-left:3px solid #7659d6;border-radius:8px;background:#fff;padding:9px;margin:6px 0}.caseCard b{font-size:9px}.caseCard p{font-size:7.5px;color:#778496;line-height:1.4;margin:4px 0}.caseCard textarea{width:100%;min-height:48px;border:1px solid #dfe5ed;border-radius:6px;padding:6px;font-size:7.5px;color:#536074;resize:vertical}.caseMeta{display:flex;gap:5px;align-items:center;flex-wrap:wrap}
.compare{display:grid;grid-template-columns:1fr 40px 1fr;gap:10px;align-items:start}.compareVs{text-align:center;font-weight:900;color:#9aa4b2;padding-top:55px}.compareCol{border:1px solid var(--line);border-radius:10px;padding:11px;background:#fff}.compareCol h3{font-size:11px;margin:0 0 8px}.metricRow{display:grid;grid-template-columns:1fr auto;gap:8px;padding:7px 0;border-bottom:1px solid #eef1f5}.metricRow span{font-size:7.5px;color:#748195}.metricRow b{font-size:8px}
.path{border:1px solid var(--line);border-radius:8px;padding:8px;margin:5px 0;background:#fff}.pathline{display:flex;align-items:center;gap:4px;flex-wrap:wrap}.pathnode{font-size:6.8px;padding:4px 5px;border-radius:5px;background:#edf3ff;color:#285ab6;cursor:pointer}.arrow{font-size:8px;color:#9aa4b2}.hub{display:flex;gap:8px;align-items:center;padding:7px;border-bottom:1px solid #eef1f5;cursor:pointer}.hub:hover{background:#f8faff}.hub .deg{width:31px;height:31px;border-radius:50%;display:flex;align-items:center;justify-content:center;background:#edf3ff;color:#285ab6;font-weight:850;font-size:9px}.hub b{font-size:8.5px}.hub small{display:block;font-size:7px;color:#8290a1;margin-top:2px}
.readiness{display:flex;align-items:center;gap:8px}.readiness b{font-size:18px}.donut{width:44px;height:44px;border-radius:50%;display:grid;place-items:center;background:conic-gradient(#2b6ff3 var(--p),#e8edf4 0)}.donut:after{content:"";width:31px;height:31px;border-radius:50%;background:#fff}.donut span{position:absolute;font-size:7px;font-weight:850;z-index:1}
.brief{border-left:3px solid #2b6ff3;background:#f8fbff;padding:10px;border-radius:7px;font-size:8px;line-height:1.5;color:#576578}.brief b{color:#25344a}
@media(max-width:1260px){.appsbar{top:113px}.appgrid{grid-template-columns:1fr 1fr}}@media(max-width:850px){.appsbar{top:155px;padding:0 9px}.compare{grid-template-columns:1fr}.compareVs{padding:0}.appgrid{grid-template-columns:1fr}}
@media(max-width:1260px){.workspace{grid-template-columns:235px 1fr}.right{display:none}.two,.equal{grid-template-columns:1fr}.brand{width:185px;min-width:185px}}@media(max-width:850px){.header{height:auto;min-height:66px;flex-wrap:wrap;padding:9px}.command{order:3;flex-basis:100%;max-width:none}.filters{top:108px;overflow:auto;padding:0 9px}.workspace{grid-template-columns:1fr}.left{display:none}.center{padding:10px}.kpis{grid-template-columns:1fr 1fr}.headright{display:none}}

.loadingmini{padding:18px;text-align:center;color:#768397;font-size:9px}.loadingmini:before{content:"";display:inline-block;width:11px;height:11px;border:2px solid #d9e1ec;border-top-color:#2b6ff3;border-radius:50%;animation:spin .7s linear infinite;margin-right:7px;vertical-align:-3px}.readytag{font-size:8px;color:#2a7d5e;background:#eef9f4;border:1px solid #cde9dc;padding:4px 6px;border-radius:6px}.bgload{font-size:8px;color:#7c8798}.searchStatus{font-size:8px;color:#718096;margin-top:6px}.detailLoad{padding:40px;text-align:center}.detailLoad b{display:block;font-size:11px}.detailLoad span{font-size:9px;color:#7a8797}

/* v0.10 interaction layer */
.backbtn{border:1px solid rgba(255,255,255,.18);background:rgba(255,255,255,.06);color:#fff;border-radius:8px;padding:7px 9px;font-size:9px;white-space:nowrap}.backbtn:disabled{opacity:.3;cursor:default}.scorebox.clickable{cursor:pointer;border-radius:8px;padding:5px 7px;transition:.15s}.scorebox.clickable:hover{background:#f1f5fc;box-shadow:inset 0 0 0 1px #dce5f4}.scorelink{border:0;background:#edf3ff;color:#2257b8;border-radius:5px;font-weight:850;padding:4px 6px;font-size:8px}.navgroup{position:relative;height:100%;display:flex;align-items:center}.navmain{border:0;background:transparent;height:100%;padding:0 11px;color:#526074;font-size:8px;font-weight:800}.navgroup.hasactive>.navmain,.navgroup.open>.navmain{color:#1f57b8;background:#edf3ff}.navmenu{display:none;position:absolute;top:38px;left:0;min-width:220px;padding:6px;background:#fff;border:1px solid var(--line);border-radius:9px;box-shadow:0 12px 28px rgba(16,24,40,.16);z-index:50}.navgroup.open .navmenu{display:grid;gap:2px}.navmenu button{border:0;background:#fff;text-align:left;border-radius:6px;padding:8px 9px;color:#3f4d62;font-size:8px}.navmenu button:hover,.navmenu button.active{background:#edf3ff;color:#1e55b5}.navmenu small{float:right;color:#8994a4}.navhint{margin-left:auto;font-size:7px;color:#8994a4;padding-right:7px}.appbtn.active{background:#edf3ff!important;color:#2158b8!important}.sheetback{position:fixed;inset:0;background:rgba(7,18,37,.36);z-index:69;opacity:0;pointer-events:none;transition:.18s}.sheetback.on{opacity:1;pointer-events:auto}.summarySheet{position:fixed;right:-480px;top:0;width:460px;max-width:94vw;height:100vh;background:#fff;z-index:70;box-shadow:-14px 0 38px rgba(16,24,40,.18);transition:.2s;overflow:auto}.summarySheet.on{right:0}.sheetHead{height:66px;background:var(--navy);color:#fff;padding:0 15px;display:flex;align-items:center}.sheetHead small{display:block;color:#9eb0ca;font-size:6px;letter-spacing:.6px}.sheetHead b{display:block;font-size:12px;margin-top:2px}.sheetHead button{margin-left:auto;border:0;background:transparent;color:#fff;font-size:24px}.sheetBody{padding:14px}.sheetSection{margin-top:14px}.sheetSection h3{font-size:9px;margin:0 0 7px}.quickScore{display:flex;align-items:center;gap:11px;border:1px solid var(--line);border-radius:10px;padding:10px;margin:10px 0;cursor:pointer}.scoreRing{width:52px;height:52px;border-radius:50%;display:grid;place-items:center;background:#edf3ff;color:#2358b6;font-size:14px;font-weight:900}.quickScore b{font-size:9px}.quickScore p{margin:3px 0 0;font-size:8px;color:#748094}.metrics2{display:grid;grid-template-columns:1fr 1fr;gap:7px;margin:9px 0}.metrics2>div{border:1px solid var(--line);border-radius:8px;padding:8px}.metrics2 b{display:block;font-size:15px}.metrics2 span{font-size:7px;color:#7d8999}.reportTabs{display:flex;gap:5px;margin:0 0 10px}.reportTabs button{border:1px solid var(--line);background:#fff;border-radius:8px;padding:7px 10px;font-size:8px;color:#5f6d80}.reportTabs button.on{background:#edf3ff;color:#2258b8;border-color:#cfdcff;font-weight:800}.reportKpi{}.metricRow{display:flex;align-items:center;gap:8px;padding:7px 0;border-bottom:1px solid #eef1f5;font-size:8px}.metricRow>span{flex:1;color:#5f6c7e}.metricRow b{font-size:9px}.metricRow.big{padding:9px 0}.metricRow.big span b{display:block;color:#344054}.metricRow.big small{display:block;font-size:7px;color:#8792a2;margin-top:2px}.definition{border:1px solid #dce5f4;background:#f8fbff;border-radius:9px;padding:11px;margin-bottom:9px}.definition>b{font-size:9px}.definition p{font-size:8px;color:#687587;line-height:1.5}.formula{font-family:ui-monospace,SFMono-Regular,Menlo,monospace;background:#fff;border:1px solid #dfe5ed;border-radius:6px;padding:8px;margin:8px 0;font-size:8px;color:#3f4f66}.cadence{font-size:6.5px;border-radius:5px;padding:3px 5px;background:#f3f5f8;color:#5e6b7c}.cadence.mensual{background:#edf3ff;color:#2458b8}.cadence.trimestral{background:#eff9f5;color:#267257}.cadence.semestral{background:#fff7eb;color:#946026}.alertList{display:grid;gap:6px}.alertItem{display:flex;align-items:center;gap:8px;border:1px solid var(--line);border-radius:8px;padding:8px;cursor:pointer}.alertItem:hover{background:#fbfcfe}.alertItem>div{flex:1}.alertItem b{font-size:8px}.alertItem p{font-size:7px;color:#7b8797;margin:3px 0}.alertDot{width:8px;height:8px;border-radius:50%;background:var(--amber)}.mutedP{font-size:8px;color:#687587;line-height:1.5}.roeWindow{border:1px solid var(--line);border-radius:8px;padding:9px;margin:6px 0;position:relative}.roeWindow>span{float:right;font-size:6px;border-radius:999px;background:#f3f5f8;padding:3px 5px}.roeWindow.active{border-color:#9dc5b4;background:#f3fbf7}.roeWindow.active>span{background:#dff3e8;color:#267257}.roeWindow b{font-size:8px}.roeWindow p{font-size:7px;color:#7b8797;margin:4px 0 0}.roeBars{height:175px;display:flex;align-items:flex-end;justify-content:space-around;border-bottom:1px solid #dfe5ed;padding:8px}.roeBars>div{height:100%;display:flex;flex-direction:column;align-items:center;justify-content:flex-end;gap:4px}.roeBars i{width:27px;background:#2b6ff3;border-radius:4px 4px 0 0}.roeBars span{font-size:6px;color:#6e7a8c}.roeBars b{font-size:7px}.roeState{border-radius:9px;padding:11px;border:1px solid #f0d7b5;background:#fff9ef}.roeState b{font-size:10px;color:#8c5e29}.roeState p{font-size:8px;color:#766343;line-height:1.5}.availability{display:flex;gap:8px;align-items:center;padding:8px;border-bottom:1px solid #eef1f5;font-size:8px}.availability b{width:18px;height:18px;border-radius:50%;display:grid;place-items:center}.availability.yes b{background:#eaf7f1;color:#267257}.availability.partial b{background:#fff5e9;color:#99652c}.availability.no b{background:#fff0f2;color:#a6414a}.subjectBoundary{margin-top:10px}.subjectBoundary>b{font-size:9px}.subjectBoundary p{font-size:8px;color:#667386;line-height:1.5}.mobilebar{display:none}.mobileGrid{display:grid;grid-template-columns:repeat(3,1fr);gap:7px}.mobileGrid button{border:1px solid var(--line);background:#fff;border-radius:10px;padding:13px 6px;display:grid;gap:5px;place-items:center;color:#435168}.mobileGrid button>b{font-size:7px}.mobileGrid button:first-letter{font-size:18px}
@media(max-width:850px){body{padding-bottom:61px}.appsbar{display:none}.header{padding:8px;gap:7px}.brand{min-width:0;width:auto;flex:1}.brand b{font-size:12px}.brand small{font-size:6.5px}.backbtn{order:-1;padding:7px}.backbtn span{display:none}.command{order:3;flex-basis:100%;height:38px}.command input{font-size:10px}.filters{top:104px;height:43px}.filters .fl:nth-of-type(n+3),.filters select:nth-of-type(n+3),.filters .live{display:none}.workspace{min-height:calc(100vh - 147px)}.center{padding:8px}.answer{padding:12px}.answer h1{font-size:16px}.answerTop{display:block}.scorebox{margin:8px 0 0;text-align:left;display:inline-block}.kpis{grid-template-columns:1fr 1fr;gap:6px}.kpi{min-height:68px;padding:9px}.kpi b{font-size:17px}.grid.two,.grid.equal{display:block}.grid.two>.card,.grid.equal>.card{margin-bottom:8px}.tablewrap{max-height:430px}.panel{padding:10px}.summarySheet{top:auto;bottom:0;right:0;width:100%;max-width:none;height:84vh;border-radius:16px 16px 0 0;transform:translateY(110%)}.summarySheet.on{bottom:0;right:0;transform:translateY(0)}.sheetHead{height:56px;border-radius:16px 16px 0 0}.sheetBody{padding:12px}.mobilebar{display:grid;grid-template-columns:repeat(4,1fr);position:fixed;bottom:0;left:0;right:0;height:58px;background:#fff;border-top:1px solid var(--line);z-index:60;box-shadow:0 -6px 18px rgba(16,24,40,.08)}.mobilebar button{border:0;background:#fff;display:grid;place-items:center;color:#657286;font-size:7px;padding:4px}.mobilebar button b{font-size:16px;color:#31425d}.mobilebar button span{margin-top:-5px}.reportTabs{overflow:auto}.reportTabs button{white-space:nowrap}.mobileGrid{grid-template-columns:repeat(3,1fr)}.chart{height:auto}.right{display:none}}
</style><link rel="stylesheet" href="./desktop_refine.css"><link rel="stylesheet" href="./pattern_engine.css"></head><body>
<div class="header"><div class="brand"><b>AML Analytical Workbench</b><small id="snap">cargando núcleo avanzado…</small></div><div class="command"><span>⌕</span><input id="query" placeholder="Entidad, RUT, sector, región o consulta analítica…"><button onclick="WB.runQuery()">Analizar</button></div><div class="headright"><button class="sys" id="dataStatus" onclick="WB.showHealth()"><span class="dot"></span>Listo</button><button class="export" onclick="WB.exportContext()">Exportar contexto</button></div></div>
<div class="filters"><span class="fl">Sector</span><select id="sector"><option value="">Todos</option></select><span class="fl">Región</span><select id="region"><option value="">Todo Chile</option></select><span class="fl">Fuente findings</span><select id="source"><option value="">Todas</option><option value="RADAR_SII">SII</option><option value="RADAR_UAF">UAF</option><option value="RADAR_SANCIONES">Sanciones</option><option value="RADAR_CGR">CGR</option><option value="RADAR_DELICTUAL">Delictual</option><option value="RADAR_OSFL">OSFL</option></select><span class="fl">Fuentes ≥</span><select id="minsources"><option selected>1</option><option>2</option><option>3</option></select><div class="grow"></div><span class="live">DATOS REALES · ARCHIVOS LOCALES</span></div>
<div class="appsbar" id="appsbar">
<button class="appbtn on" data-app="home" onclick="WB.showApp('home')">⌂ Inicio</button>
<button class="appbtn" data-app="fiscal" onclick="WB.showApp('fiscal')">◎ Fiscalización <span class="appcount">117k</span></button>
<button class="appbtn" data-app="sanctions" onclick="WB.showApp('sanctions')">⚖ Sanciones <span class="appcount">974</span></button>
<button class="appbtn" data-app="anomalies" onclick="WB.showApp('anomalies')">⌁ Anomalías <span class="appcount">12.7k</span></button>
<button class="appbtn" data-app="signals" onclick="WB.showApp('signals')">◆ Señales AML <span class="appcount">5</span></button>
<button class="appbtn" data-app="convergence" onclick="WB.showApp('convergence')">✣ Convergencia <span class="appcount">8.9k</span></button>
<button class="appbtn" data-app="network" onclick="WB.showApp('network')">◉ Redes <span class="appcount">1.7k</span></button>
<button class="appbtn" data-app="territory" onclick="WB.showApp('territory')">⌖ Territorio <span class="appcount">345</span></button>
<button class="appbtn" data-app="cgr" onclick="WB.showApp('cgr')">▣ CGR <span class="appcount">90</span></button>
<button class="appbtn" data-app="compare" onclick="WB.showApp('compare')">⇄ Comparar</button>
<button class="appbtn" data-app="cases" onclick="WB.showApp('cases')">★ Casos <span class="appcount" id="caseCount">0</span></button>
</div>
<div class="workspace"><aside class="left"><div class="st"><b>Qué merece atención</b><small>datos reales</small></div><div id="focusList"></div><div class="leftnote">El arranque usa sólo agregados gobernados. Los archivos pesados se leen cuando eliges una operación.</div></aside><main class="center" id="canvas"><div class="card panel"><b>Iniciando mesa analítica…</b></div></main><aside class="right"><div class="st"><b>Contexto y evidencia</b><small>trazabilidad</small></div><div id="context"></div></aside></div>
<script src="./data/core.js"></script><script src="./data/advanced.js"></script><script src="./data/reportability.js"></script><script src="./data/patterns.js"></script><script src="./data/fiscalizacion/manifest.js"></script><script src="./data/fiscalizacion/acteco.js"></script><script src="./app.js"></script><script src="./enhancements.js"></script><script src="./desktop_refine.js"></script><script src="./pattern_engine.js"></script></body></html>